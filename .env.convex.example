# Environment variables for the CONVEX DEPLOYMENT (not a file Convex reads!).
# Set each one in the Convex dashboard (Settings → Environment Variables) or with:
#   npx convex env set NAME value
# Generate secrets with:  openssl rand -hex 32

# Clerk Frontend API URL, e.g. https://verb-noun-00.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=

# Where Convex POSTs signed request events (n8n production webhook URL),
# e.g. https://n8n.example.com/webhook/lendloop-request
N8N_REQUEST_WEBHOOK_URL=

# Convex → n8n signing secret (must equal LENDLOOP_TO_N8N_SECRET on the n8n host)
LENDLOOP_TO_N8N_SECRET=

# n8n → Convex signing secret (must equal N8N_TO_LENDLOOP_SECRET on the n8n host)
N8N_TO_LENDLOOP_SECRET=

# Dev deployments only: enables `npx convex run seed:*` helpers. Leave unset in production.
LENDLOOP_ALLOW_SEED=
