# n8n host environment → copy to n8n/.env (never commit it). Used by docker-compose.yml.
# Generate secrets with:  openssl rand -hex 32

# Encrypts n8n's stored credentials. Generate once and keep it safe.
N8N_ENCRYPTION_KEY=

# Public base URL of this n8n instance (used to build webhook URLs).
# Local: http://localhost:5678/   Hosted: https://n8n.example.com/
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Africa/Lagos

# Your Convex HTTP Actions URL (ends in .convex.site, NOT .convex.cloud), no trailing slash.
# Local Convex backend from Docker: http://host.docker.internal:3211
LENDLOOP_CONVEX_SITE_URL=

# Must match the values set on the Convex deployment.
LENDLOOP_TO_N8N_SECRET=
N8N_TO_LENDLOOP_SECRET=
