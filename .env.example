# Next.js app → copy to .env.local (never commit .env.local)
# `npx convex dev` fills in the two CONVEX lines for you.

# Clerk → Dashboard → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Convex (written by `npx convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Optional: opt out of Clerk SDK telemetry in development
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED=1
